FROM node:22-alpine

WORKDIR /app

COPY package.json yarn.lock .yarnrc.yml tsconfig.base.json tsconfig.json ./
COPY .yarn/ .yarn/
COPY packages/ ./packages/

RUN corepack enable && corepack prepare yarn@4.6.0 --activate
RUN yarn install --immutable

COPY vitest.config.ts ./
COPY src/ ./src/
COPY tests/ ./tests/

CMD ["yarn", "test"]
