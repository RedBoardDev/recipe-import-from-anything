{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@ria/domain": ["packages/domain/src/index.ts"],
      "@ria/application": ["packages/application/src/index.ts"],
      "@ria/pipelines": ["packages/pipelines/src/index.ts"]
    },
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  }
}
