# Copy this file to .env and fill in the values

# =============================================================================
# Redis (BullMQ Queue)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# =============================================================================
# Application
# =============================================================================
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
# DEBUG=false
# LOG_LEVEL=info

# =============================================================================
# CORS
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# JWT Authentication
# =============================================================================
JWT_SECRET=change-me-in-production
JWT_ISSUER=recipe-import
JWT_AUDIENCE=recipe-import-api

# =============================================================================
# Mistral LLM (Text Pipeline)
# =============================================================================
# MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
MISTRAL_OCR_MODEL=mistral-ocr-latest
MISTRAL_API_BASE_URL=https://api.mistral.ai
MISTRAL_TIMEOUT_MS=45000
MISTRAL_OCR_TIMEOUT_MS=90000
MISTRAL_RETRY_ATTEMPTS=2
MISTRAL_RETRY_BASE_DELAY_MS=500
MISTRAL_OCR_RETRY_ATTEMPTS=2
MISTRAL_OCR_RETRY_BASE_DELAY_MS=700
MISTRAL_STRUCTURED_OUTPUT=false

# =============================================================================
# Pipeline-Contracts Model Config (LLM_MODEL, OCR_MODEL, etc.)
# =============================================================================
# LLM_MODEL=mistral-large-latest
# OCR_MODEL=mistral-ocr-latest
# ENABLE_FALLBACK=true
# LLM_MAX_RETRIES=3
# LLM_TIMEOUT_MS=30000

# =============================================================================
# Worker
# =============================================================================
MAX_CONCURRENT_JOBS=2
BULLMQ_LOCK_DURATION_MS=60000
BULLMQ_REMOVE_ON_COMPLETE=100
BULLMQ_REMOVE_ON_FAIL=100
# BULLMQ_RATE_LIMIT_MAX=10
# BULLMQ_RATE_LIMIT_DURATION_MS=1000
# BULLMQ_STALLED_INTERVAL_MS=30000
# BULLMQ_MAX_STALLED_COUNT=1
BULLMQ_RETRY_ATTEMPTS=2
BULLMQ_RETRY_BACKOFF_TYPE=exponential
BULLMQ_RETRY_BACKOFF_DELAY_MS=5000
BULLMQ_JOB_TIMEOUT_MS=120000

# =============================================================================
# API Rate Limiting
# =============================================================================
API_RATE_LIMIT_MAX=100
API_RATE_LIMIT_WINDOW_MS=60000

# =============================================================================
# Body Limit (10MB)
# =============================================================================
MAX_PAYLOAD_SIZE=10485760
