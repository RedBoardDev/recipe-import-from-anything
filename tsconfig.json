{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "outDir": "./dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "tests/**/*",
    "packages/**/*",
    "src/domain/**/*",
    "src/pipelines/**/*"
  ],
  "references": [
    { "path": "./packages/domain" },
    { "path": "./packages/pipeline-contracts" },
    { "path": "./packages/pipelines/images" },
    { "path": "./packages/pipelines/text" }
  ]
}
